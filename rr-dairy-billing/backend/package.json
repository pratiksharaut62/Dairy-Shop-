{
  "name": "rr-billing-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RR Dairy cloud API \u2014 NestJS + PostgreSQL (Neon)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "ts-node src/cli/migrate.ts",
    "provision": "ts-node src/cli/provision.ts",
    "super-admin": "ts-node src/cli/super-admin.ts",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --config test/jest-e2e.json",
    "migrate:prod": "node dist/cli/migrate.js",
    "provision:prod": "node dist/cli/provision.js",
    "super-admin:prod": "node dist/cli/super-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.2.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
