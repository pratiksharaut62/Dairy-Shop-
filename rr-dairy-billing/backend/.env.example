# --- Neon (https://neon.tech) ---------------------------------------------
# Project → Connection Details → copy the *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth -------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=
# Session length in seconds (12 hours)
JWT_TTL_SECONDS=43200

# --- HTTP -------------------------------------------------------------------
PORT=8080
# Comma-separated browser origins allowed to call the API (the hosted web app).
# The packaged desktop app is always allowed.
CORS_ORIGINS=http://localhost:5173
